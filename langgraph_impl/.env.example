# 复制本文件为 .env，填入你要用的那一种（只填一种即可），其余保持注释。
# 用法: cp .env.example .env  然后在编辑器里填 key（.env 已被 .gitignore 忽略）

# ── Claude ──────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-5

# ── DeepSeek ────────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# ── Kimi / Moonshot ─────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-8k

# ── 通义千问 Qwen（DashScope 兼容模式）──────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ── 智谱 GLM ────────────────────────────────────────────
# OPENAI_API_KEY=xxx
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4-plus

# ── OpenAI 官方 ─────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# ── LangSmith 追踪（可选，开启后在 smith.langchain.com 看链路）──
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxx          # LangSmith 后台 Settings 里获取
# LANGSMITH_PROJECT=localization-demo
